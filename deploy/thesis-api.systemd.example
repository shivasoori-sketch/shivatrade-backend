[Unit]
Description=THESIS FastAPI (v2 candle-close engine)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/shivtrade/research/shivatrade-backend
Environment=PYTHONPATH=/opt/shivtrade/research/shivatrade-backend
ExecStart=/opt/shivtrade/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 5098 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
